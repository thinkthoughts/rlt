; REJECT CASE: the ¬(1 < m) certificate applied to 2 (2 is prime)
(rlt-proof
  (id RLT007S2a.SY07)
  (convention NAT-DEF)
  (goal "¬(1 < 2 ∧ ∀d. ((1 < d ∧ d < 2) → ¬(d ∣ 2)))")
  (mode unconditional)
  (axioms ROBINSON-Q)
  (params z0)
  (steps
    (X2_H (and (lt 1 2) (forall d (imp (and (lt 1 d) (lt d 2)) (not (dvd d 2))))) (hyp X2_hp))
    (X2_L (lt 1 2) (and-left X2_H))
    (X2_hz (= (+ (S z0) 1) 2) (hyp X2_hzz))
    (X2_a (= (+ (S z0) 1) (S (+ (S z0) 0))) (inst add_succ (x (S z0)) (y 0)))
    (X2_b (= 0 (+ (S z0) 1)) (symm X2_hz))
    (X2_c (= 0 (S (+ (S z0) 0))) (trans X2_b X2_a))
    (X2_q (not (= 0 (S (+ (S z0) 0)))) (inst q2_zero_ne_succ (x (+ (S z0) 0))))
    (X2_f false (imp-elim X2_q X2_c))
    (X2_F false (exists-elim X2_L z0 X2_hzz X2_f))
    (G (not (and (lt 1 2) (forall d (imp (and (lt 1 d) (lt d 2)) (not (dvd d 2)))))) (imp-intro X2_hp X2_F))))
