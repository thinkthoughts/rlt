; RLT-007b stage 2a: exhaustiveness for range 4: every p in [113, 156] with Prime_B(p) is one of [113, 127, 131, 137, 139, 149, 151]. Cites the non-prime certificates tests/rlt007s2a/accept/N_4.rlt.
(rlt-proof
  (id RLT007S2a.E_4)
  (convention NAT-DEF)
  (goal "∀p. (((112 < p ∧ p < 157) ∧ (1 < p ∧ ∀d. ((1 < d ∧ d < p) → ¬(d ∣ p)))) → (p = 113 ∨ (p = 127 ∨ (p = 131 ∨ (p = 137 ∨ (p = 139 ∨ (p = 149 ∨ p = 151)))))))")
  (mode unconditional)
  (axioms ROBINSON-Q)
