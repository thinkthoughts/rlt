; REJECT CASE: an altered residue class, 2 mod 47, is occupied by 2 = 47 × 0 + 2
(rlt-proof
  (id RLT007S4.D_047_002)
  (convention NAT-DEF)
  (goal "¬(∃k. 2 = (47 × k) + 2)")
  (mode unconditional)
  (axioms ROBINSON-Q)
  (params k0)
  (steps
    (H (exists k (= 2 (+ (* 47 k) 2))) (hyp hx))
    (F (= 2 (+ (* 47 k0) 2)) (hyp h0))
    (r0 (= (+ (* 47 k0) 0) (* 47 k0)) (inst add_zero (x (* 47 k0))))
    (ra1 (= (+ (* 47 k0) 1) (S (+ (* 47 k0) 0))) (inst add_succ (x (* 47 k0)) (y 0)))
    (rc1 (= (S (+ (* 47 k0) 0)) (S (* 47 k0))) (cong S r0))
    (r1 (= (+ (* 47 k0) 1) (S (* 47 k0))) (trans ra1 rc1))
    (ra2 (= (+ (* 47 k0) 2) (S (+ (* 47 k0) 1))) (inst add_succ (x (* 47 k0)) (y 1)))
    (rc2 (= (S (+ (* 47 k0) 1)) (S (S (* 47 k0)))) (cong S r1))
    (r2 (= (+ (* 47 k0) 2) (S (S (* 47 k0)))) (trans ra2 rc2))
    (T (= 2 (S (S (* 47 k0)))) (trans F r2))
    (pi2 (imp (= (S 1) (S (S (* 47 k0)))) (= 1 (S (* 47 k0)))) (inst q1_succ_inj (x 1) (y (S (* 47 k0)))))
    (pl2 (= 1 (S (* 47 k0))) (imp-elim pi2 T))
    (pi1 (imp (= (S 0) (S (* 47 k0))) (= 0 (* 47 k0))) (inst q1_succ_inj (x 0) (y (* 47 k0))))
    (pl1 (= 0 (* 47 k0)) (imp-elim pi1 pl2))
    (q2 (not (= 0 (* 47 k0))) (inst q2_zero_ne_succ (x (* 47 k0))))
    (fin false (imp-elim q2 pl1))
    (E false (exists-elim H k0 h0 fin))
    (G (not (exists k (= 2 (+ (* 47 k) 2)))) (imp-intro hx E))))
