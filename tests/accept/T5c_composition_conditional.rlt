; T5c · accept (conditional) — composition preserves dependencies.
; From the imagined assumption h : 1 + 1 = 3, cong over + carries h into
; (1 + 1) + 1 = 3 + 1. Reported Γ = { h }.
(rlt-proof
  (id T5c.composition.conditional)
  (readingpoint math0)
  (context F1 fiction)
  (convention NAT-DEC)
  (goal "1 + 1 + 1 = 3 + 1")
  (assume h "1 + 1 = 3")
  (mode conditional)
  (axioms PEANO-ADD)
  (steps
    (s1 (= (+ 1 1) 3)              (hyp h))
    (s2 (= 1 1)                    (refl 1))
    (s3 (= (+ (+ 1 1) 1) (+ 3 1))  (cong + s1 s2))))
