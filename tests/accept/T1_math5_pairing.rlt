; T1 · accept — math5 relationship 5 + 1 = 6, four steps.
; Verified rule: transitivity of equality (premises from inst and cong).
(rlt-proof
  (id T1.math5.pairing)
  (readingpoint math5)
  (relationship math5.pairing)
  (convention NAT-DEC)
  (goal "5 + 1 = 6")
  (mode unconditional)
  (axioms "spec/peano.rlt")
  (steps
    (s1 (= (+ 5 (S 0)) (S (+ 5 0)))  (inst add_succ (x 5) (y 0)))
    (s2 (= (+ 5 0) 5)                (inst add_zero (x 5)))
    (s3 (= (S (+ 5 0)) (S 5))        (cong S s2))
    (s4 (= (+ 5 (S 0)) (S 5))        (trans s1 s3))))
