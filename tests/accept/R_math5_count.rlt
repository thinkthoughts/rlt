; math5 relationship 1 + 1 + 1 + 1 + 1 = 5 (repairearth.ai's counting equation).
; Generated by hand-reviewed script: each k + 1 = k+1 by the T1 shape, then cong over + and trans.
(rlt-proof
  (id R.math5.count)
  (readingpoint math5)
  (relationship math5.count)
  (convention NAT-DEC)
  (goal "1 + 1 + 1 + 1 + 1 = 5")
  (mode unconditional)
  (axioms "spec/peano.rlt")
  (steps
    (p1a (= (+ 1 (S 0)) (S (+ 1 0)))  (inst add_succ (x 1) (y 0)))
    (p1b (= (+ 1 0) 1)                (inst add_zero (x 1)))
    (p1c (= (S (+ 1 0)) (S 1))        (cong S p1b))
    (p1d (= (+ 1 (S 0)) (S 1))        (trans p1a p1c))
    (one (= 1 1) (refl 1))
    (c2 (= (+ (+ 1 1) 1) (+ 2 1))  (cong + p1d one))
    (p2a (= (+ 2 (S 0)) (S (+ 2 0)))  (inst add_succ (x 2) (y 0)))
    (p2b (= (+ 2 0) 2)                (inst add_zero (x 2)))
    (p2c (= (S (+ 2 0)) (S 2))        (cong S p2b))
    (p2d (= (+ 2 (S 0)) (S 2))        (trans p2a p2c))
    (t2 (= (+ (+ 1 1) 1) 3)  (trans c2 p2d))
    (c3 (= (+ (+ (+ 1 1) 1) 1) (+ 3 1))  (cong + t2 one))
    (p3a (= (+ 3 (S 0)) (S (+ 3 0)))  (inst add_succ (x 3) (y 0)))
    (p3b (= (+ 3 0) 3)                (inst add_zero (x 3)))
    (p3c (= (S (+ 3 0)) (S 3))        (cong S p3b))
    (p3d (= (+ 3 (S 0)) (S 3))        (trans p3a p3c))
    (t3 (= (+ (+ (+ 1 1) 1) 1) 4)  (trans c3 p3d))
    (c4 (= (+ (+ (+ (+ 1 1) 1) 1) 1) (+ 4 1))  (cong + t3 one))
    (p4a (= (+ 4 (S 0)) (S (+ 4 0)))  (inst add_succ (x 4) (y 0)))
    (p4b (= (+ 4 0) 4)                (inst add_zero (x 4)))
    (p4c (= (S (+ 4 0)) (S 4))        (cong S p4b))
    (p4d (= (+ 4 (S 0)) (S 4))        (trans p4a p4c))
    (t4 (= (+ (+ (+ (+ 1 1) 1) 1) 1) 5)  (trans c4 p4d))))
