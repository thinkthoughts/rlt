; RLT-003 M3a test A07. Generated by scripts/gen-m3a-tests.py.
(rlt-proof
  (id M3a.A07)
  (convention NAT-LOGIC)
  (goal "1 + 1 = 2 ∨ 1 + 1 = 3")
  (mode unconditional)
  (axioms PEANO-ADD)
  (steps
