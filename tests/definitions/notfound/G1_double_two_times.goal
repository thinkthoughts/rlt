; RLT-PROVER-002: true in ℕ, needs induction: Robinson's Q does not settle it.
(rlt-goal
  (id G1.double_two_times)
  (convention NAT-FUN)
  (definitions "definitions/double.rlt" "8dabb459817f7b225419456080a4e81eb675daf9a830dba529192ff50cfbc2f7")
  (goal "∀x. double(x) = 2 × x")
  (mode unconditional)
  (axioms ROBINSON-Q))
