(rlt-proof
  (id K05_goal_mismatch)
  (convention NAT-DEC)
  (goal "1 + 1 = 3")
  (mode unconditional)
  (axioms PEANO-ADD)
  (steps
    (s1 (= (+ 1 (S 0)) (S (+ 1 0)))  (inst add_succ (x 1) (y 0)))
    (s2 (= (+ 1 0) 1)                (inst add_zero (x 1)))
    (s3 (= (S (+ 1 0)) (S 1))        (cong S s2))
    (s4 (= (+ 1 (S 0)) (S 1))        (trans s1 s3))))
