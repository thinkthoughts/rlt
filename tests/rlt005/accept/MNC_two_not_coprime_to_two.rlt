    (s10 (imp (= 2 1) (= 1 0)) (inst q1_succ_inj (x 1) (y 0)))
    (s11 (= 1 0) (imp-elim s10 s9))
    (s12 (= 0 1) (symm s11))
    (s13 (not (= 0 1)) (inst q2_zero_ne_succ (x 0)))
    (s14 false (imp-elim s13 s12))
    (G (not (forall k (imp (and (and (lt 0 k) (dvd k 2)) (dvd k 2)) (= k 1)))) (imp-intro hc s14))))
