    (s2 (imp (and (and (lt 0 2) (dvd 2 2)) (dvd 2 2)) (= 2 1)) (forall-elim s1 2))
    (g3_1 (= (+ 2 0) 2) (inst add_zero (x 2)))
    (g3_2 (= 2 (+ 2 0)) (symm g3_1))
