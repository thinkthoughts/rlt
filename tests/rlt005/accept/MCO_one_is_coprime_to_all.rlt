    (s5 (= (+ (S pz) 0) pk) (hyp hz))
    (s6 (= (+ (S pz) 0) (S pz)) (inst add_zero (x (S pz))))
    (s7 (= (S pz) (+ (S pz) 0)) (symm s6))
    (s8 (= (S pz) pk) (trans s7 s5))
    (s9 (= pk (S pz)) (symm s8))
    (s10 (= 1 (* pk pj)) (hyp hj))
    (s11 (or (= pj 0) (exists y (= pj (S y)))) (inst q3_zero_or_succ (x pj)))
    (s12 (= pj 0) (hyp jz))
    (s13 (= pk pk) (refl pk))
    (s14 (= (* pk pj) (* pk 0)) (cong * s13 s12))
    (s15 (= (* pk 0) 0) (inst mul_zero (x pk)))
    (s16 (= (* pk pj) 0) (trans s14 s15))
    (s17 (= 1 0) (trans s10 s16))
    (s18 (= 0 1) (symm s17))
    (s19 (not (= 0 1)) (inst q2_zero_ne_succ (x 0)))
    (s20 false (imp-elim s19 s18))
    (s21 (= pk 1) (false-elim s20))
    (s22 (exists y (= pj (S y))) (hyp js))
    (s23 (= pj (S pj1)) (hyp jw))
    (s24 (= (* pk pj) (* pk (S pj1))) (cong * s13 s23))
    (s25 (= (* pk (S pj1)) (+ (* pk pj1) pk)) (inst mul_succ (x pk) (y pj1)))
    (s26 (= (* pk pj1) (* pk pj1)) (refl (* pk pj1)))
    (s27 (= (+ (* pk pj1) pk) (+ (* pk pj1) (S pz))) (cong + s26 s9))
    (s28 (= (+ (* pk pj1) (S pz)) (S (+ (* pk pj1) pz))) (inst add_succ (x (* pk pj1)) (y pz)))
    (s29 (= (+ (* pk pj1) pk) (S (+ (* pk pj1) pz))) (trans s27 s28))
    (s30 (= (* pk (S pj1)) (S (+ (* pk pj1) pz))) (trans s25 s29))
    (s31 (= (* pk pj) (S (+ (* pk pj1) pz))) (trans s24 s30))
    (s32 (= 1 (S (+ (* pk pj1) pz))) (trans s10 s31))
    (s33 (imp (= 1 (S (+ (* pk pj1) pz))) (= 0 (+ (* pk pj1) pz))) (inst q1_succ_inj (x 0) (y (+ (* pk pj1) pz))))
    (s34 (= 0 (+ (* pk pj1) pz)) (imp-elim s33 s32))
    (s35 (or (= pz 0) (exists y (= pz (S y)))) (inst q3_zero_or_succ (x pz)))
    (s36 (= pz 0) (hyp zz))
    (s37 (= pk 1) (subst s36 (at u (= pk (S u))) s9))
    (s38 (exists y (= pz (S y))) (hyp zs))
    (s39 (= pz (S pz1)) (hyp zw))
    (s40 (= (+ (* pk pj1) pz) (+ (* pk pj1) (S pz1))) (cong + s26 s39))
    (s41 (= (+ (* pk pj1) (S pz1)) (S (+ (* pk pj1) pz1))) (inst add_succ (x (* pk pj1)) (y pz1)))
    (s42 (= (+ (* pk pj1) pz) (S (+ (* pk pj1) pz1))) (trans s40 s41))
    (s43 (= 0 (S (+ (* pk pj1) pz1))) (trans s34 s42))
    (s44 (not (= 0 (S (+ (* pk pj1) pz1)))) (inst q2_zero_ne_succ (x (+ (* pk pj1) pz1))))
    (s45 false (imp-elim s44 s43))
    (s46 (= pk 1) (false-elim s45))
    (s47 (= pk 1) (exists-elim s38 pz1 zw s46))
    (s48 (= pk 1) (or-cases s35 zz s37 zs s47))
    (s49 (= pk 1) (exists-elim s22 pj1 jw s48))
    (s50 (= pk 1) (or-cases s11 jz s21 js s49))
    (s51 (= pk 1) (exists-elim s4 pj hj s50))
    (s52 (= pk 1) (exists-elim s3 pz hz s51))
    (s53 (imp (and (and (lt 0 pk) (dvd pk pm)) (dvd pk 1)) (= pk 1)) (imp-intro hc s52))
    (s54 (forall k (imp (and (and (lt 0 k) (dvd k pm)) (dvd k 1)) (= k 1))) (forall-intro pk s53))
    (G (forall m (forall k (imp (and (and (lt 0 k) (dvd k m)) (dvd k 1)) (= k 1)))) (forall-intro pm s54))))
