    (G (forall b (forall c (forall d (imp (and (and (or (= b 1) (= b 3)) (or (= c 1) (= c 3))) (or (= d 1) (= d 3))) (or (or (= b c) (= b d)) (= c d)))))) (forall-intro pb s73))))
