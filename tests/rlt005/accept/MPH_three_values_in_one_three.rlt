    (s51 (= pb pd) (trans s39 s50))
    (s52 (or (= pb pc) (= pb pd)) (or-right s51))
    (s53 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-left s52))
    (s54 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-cases s5 h43 s48 h44 s53))
    (s55 (= pc 3) (hyp h41))
    (s58 (= pd 1) (hyp h56))
    (s59 (= 3 pc) (symm s55))
    (s60 (= pb pc) (trans s39 s59))
    (s61 (or (= pb pc) (= pb pd)) (or-left s60))
    (s62 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-left s61))
    (s63 (= pd 3) (hyp h57))
    (s64 (= 3 pc) (symm s55))
    (s65 (= pb pc) (trans s39 s64))
    (s66 (or (= pb pc) (= pb pd)) (or-left s65))
