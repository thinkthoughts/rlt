    (s24 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-cases s5 h12 s18 h13 s23))
    (s25 (= pc 3) (hyp h10))
    (s28 (= pd 1) (hyp h26))
    (s29 (= 1 pd) (symm s28))
    (s30 (= pb pd) (trans s8 s29))
    (s31 (or (= pb pc) (= pb pd)) (or-right s30))
    (s32 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-left s31))
    (s33 (= pd 3) (hyp h27))
    (s34 (= 3 pd) (symm s33))
    (s35 (= pc pd) (trans s25 s34))
    (s36 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-right s35))
    (s37 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-cases s5 h26 s32 h27 s36))
    (s38 (or (or (= pb pc) (= pb pd)) (= pc pd)) (or-cases s4 h9 s24 h10 s37))
    (s39 (= pb 3) (hyp h7))
    (s42 (= pc 1) (hyp h40))
