    (s71 (imp (and (and (or (= pb 1) (= pb 3)) (or (= pc 1) (= pc 3))) (or (= pd 1) (= pd 3))) (or (or (= pb pc) (= pb pd)) (= pc pd))) (imp-intro hh s70))
    (s72 (forall d (imp (and (and (or (= pb 1) (= pb 3)) (or (= pc 1) (= pc 3))) (or (= d 1) (= d 3))) (or (or (= pb pc) (= pb d)) (= pc d)))) (forall-intro pd s71))
