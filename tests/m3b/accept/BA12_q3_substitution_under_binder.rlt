; RLT-003 M3b test BA12. Generated by scripts/gen-m3b-tests.py.
(rlt-proof
  (id M3b.BA12)
  (convention NAT-DEF)
  (goal "∀w. ∃y. w + 1 = y + 1")
  (mode unconditional)
  (axioms ROBINSON-Q)
  (params a b)
  (steps
    (q1 (or (= (S a) 0) (exists y (= (S a) (S y)))) (inst q3_zero_or_succ (x (S a))))
    (c1 (= (S a) 0) (hyp z0))
    (c2 (= 0 (S a)) (symm c1))
    (c3 (not (= 0 (S a))) (inst q2_zero_ne_succ (x a)))
    (c4 false (imp-elim c3 c2))
    (c5 (exists y (= (+ a 1) (+ y 1))) (false-elim c4))
    (d1 (exists y (= (S a) (S y))) (hyp sy))
    (d2 (= (S a) (S b)) (hyp w))
    (e1 (= (+ a 1) (S (+ a 0))) (inst add_succ (x a) (y 0)))
    (e2 (= (+ a 0) a) (inst add_zero (x a)))
    (e3 (= (S (+ a 0)) (S a)) (cong S e2))
    (e4 (= (+ a 1) (S a)) (trans e1 e3))
    (f1 (= (+ b 1) (S (+ b 0))) (inst add_succ (x b) (y 0)))
    (f2 (= (+ b 0) b) (inst add_zero (x b)))
    (f3 (= (S (+ b 0)) (S b)) (cong S f2))
    (f4 (= (+ b 1) (S b)) (trans f1 f3))
    (d3 (= (+ a 1) (S b)) (trans e4 d2))
    (d4 (= (S b) (+ b 1)) (symm f4))
    (d5 (= (+ a 1) (+ b 1)) (trans d3 d4))
    (d6 (exists y (= (+ a 1) (+ y 1))) (exists-intro b d5))
    (d7 (exists y (= (+ a 1) (+ y 1))) (exists-elim d1 b w d6))
    (r1 (exists y (= (+ a 1) (+ y 1))) (or-cases q1 z0 c5 sy d7))
    (r2 (forall v (exists y (= (+ v 1) (+ y 1)))) (forall-intro a r1))))
