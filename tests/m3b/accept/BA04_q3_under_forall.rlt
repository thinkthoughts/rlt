; RLT-003 M3b test BA04. Generated by scripts/gen-m3b-tests.py.
(rlt-proof
  (id M3b.BA04)
  (convention NAT-DEF)
  (goal "∀x. x = 0 ∨ ∃y. x = y + 1")
  (mode unconditional)
  (axioms ROBINSON-Q)
  (params a b)
  (steps
    (q1 (or (= a 0) (exists y (= a (S y)))) (inst q3_zero_or_succ (x a)))
    (c1 (= a 0) (hyp z0))
    (c2 (or (= a 0) (exists y (= a (+ y 1)))) (or-left c1))
    (d1 (exists y (= a (S y))) (hyp sy))
    (d2 (= a (S b)) (hyp w))
    (e1 (= (+ b 1) (S (+ b 0))) (inst add_succ (x b) (y 0)))
    (e2 (= (+ b 0) b) (inst add_zero (x b)))
    (e3 (= (S (+ b 0)) (S b)) (cong S e2))
    (e4 (= (+ b 1) (S b)) (trans e1 e3))
    (d3 (= (S b) (+ b 1)) (symm e4))
    (d4 (= a (+ b 1)) (trans d2 d3))
    (d5 (exists y (= a (+ y 1))) (exists-intro b d4))
    (d6 (exists y (= a (+ y 1))) (exists-elim d1 b w d5))
    (d7 (or (= a 0) (exists y (= a (+ y 1)))) (or-right d6))
    (r1 (or (= a 0) (exists y (= a (+ y 1)))) (or-cases q1 z0 c2 sy d7))
    (r2 (forall x (or (= x 0) (exists y (= x (+ y 1))))) (forall-intro a r1))))
