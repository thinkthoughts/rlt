; RLT-003 M3b test BA05. Generated by scripts/gen-m3b-tests.py.
(rlt-proof
  (id M3b.BA05)
  (convention NAT-DEF)
  (goal "∃y. 7 = y + 1")
  (mode unconditional)
  (axioms ROBINSON-Q)
  (params b)
  (steps
    (q1 (or (= 7 0) (exists y (= 7 (S y)))) (inst q3_zero_or_succ (x 7)))
    (c1 (= 7 0) (hyp z0))
    (c2 (= 0 7) (symm c1))
    (c3 (not (= 0 7)) (inst q2_zero_ne_succ (x 6)))
    (c4 false (imp-elim c3 c2))
    (c5 (exists y (= 7 (+ y 1))) (false-elim c4))
    (d1 (exists y (= 7 (S y))) (hyp sy))
    (d2 (= 7 (S b)) (hyp w))
    (e1 (= (+ b 1) (S (+ b 0))) (inst add_succ (x b) (y 0)))
    (e2 (= (+ b 0) b) (inst add_zero (x b)))
    (e3 (= (S (+ b 0)) (S b)) (cong S e2))
    (e4 (= (+ b 1) (S b)) (trans e1 e3))
    (d3 (= (S b) (+ b 1)) (symm e4))
    (d4 (= 7 (+ b 1)) (trans d2 d3))
    (d5 (exists y (= 7 (+ y 1))) (exists-intro b d4))
    (d6 (exists y (= 7 (+ y 1))) (exists-elim d1 b w d5))
    (r1 (exists y (= 7 (+ y 1))) (or-cases q1 z0 c5 sy d6))))
