    (Y0_st (= (+ (S w) a) (S (+ (S w) a1))) (trans Y0_sc Y0_sa))
    (Y0_st2 (= 0 (S (+ (S w) a1))) (trans Y0_ls Y0_st))
    (Y0_sq (not (= 0 (S (+ (S w) a1)))) (inst q2_zero_ne_succ (x (+ (S w) a1))))
