    (Y0_zc (= (+ (S w) a) (+ (S w) 0)) (cong + Y0_r Y0_zh))
    (Y0_za (= (+ (S w) 0) (S w)) (inst add_zero (x (S w))))
    (Y0_zt (= (+ (S w) a) (S w)) (trans Y0_zc Y0_za))
