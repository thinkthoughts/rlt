    exact hn ⟨h / p, by have := Nat.div_add_mod h p; omega⟩
  · intro hne ⟨k, hk⟩
    apply hne
    rw [hk, Nat.mul_add_mod, Nat.mod_eq_of_lt hr]

/-- RLT's per-prime statement for (p, r), as a list conjunction. -/
