; RLT-CSTAR-002 goal G03_fine_20_8. C-Star accepts llm = 20 on np_xi = 8: nx = 3 (8*2 < 20 <= 8*3), offx = 4, last tile 3 - 5/2 = 1 point.
(rlt-goal
  (id CSTAR002.G03_fine_20_8)
  (convention NAT-LOGIC)
  (goal "8 × 2 + 4 = 20 ∧ 8 × 3 = 20 + 4 ∧ 2 + 1 = 3")
  (mode unconditional)
  (axioms ROBINSON-Q))
